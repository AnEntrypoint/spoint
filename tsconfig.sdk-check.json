{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "strict": false,
    "types": ["node"]
  },
  "include": [
    "src/sdk/**/*.js",
    "src/apps/AppContext.js"
  ]
}
